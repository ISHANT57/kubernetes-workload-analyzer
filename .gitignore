# --- Credentials and secrets (never commit) ---
kubeconfig
*.kubeconfig
kubeconfig*.yaml
.kube/
.env
.env.*
!.env.example
*.pem
*.key
*.crt
*.p12
*.pfx
secrets/
*-secret.yaml
*.secret.yaml

# --- Local cluster / tool state ---
.minikube/
.kind/
*.tgz
charts/*/charts/

# --- Build output ---
bin/
dist/
build/
out/
coverage/
*.out
*.test
*.prof

# --- Go (backend/) ---
backend/analyzer
backend/cmd/*/*.exe

# --- Language tooling (whichever runtime is chosen) ---
vendor/
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
node_modules/

# --- Editors / OS ---
.idea/
.vscode/
*.swp
.DS_Store

# --- Scratch ---
tmp/
*.log
.playwright-mcp/
